# Copy this file to .env and fill in your actual keys
# Never commit the real .env file to Git!

# Groq API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# IBM watsonx.ai (optional — for Granite model)
IBM_WATSON_API_KEY=your_ibm_watson_api_key_here
IBM_WATSON_PROJECT_ID=your_project_id_here
IBM_WATSON_URL=https://us-south.ml.cloud.ibm.com

# Optional: suppress HuggingFace symlink warning on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1
